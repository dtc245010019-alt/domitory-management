@model IEnumerable<QLKTX.Models.CoSoVatChat>

@{
    ViewData["Title"] = "Quản lý Cơ sở vật chất";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">QUẢN LÝ CƠ SỞ VẬT CHẤT</h4>
            <a asp-action="Create" class="btn btn-light btn-sm fw-bold"><i class="bi bi-plus-lg"></i> Thêm thiết bị mới</a>
        </div>
        <div class="card-body">

            <form asp-action="Index" method="get" class="mb-4 d-flex">
                <div class="input-group w-50 shadow-sm border-primary">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Nhập tên thiết bị, phòng hoặc tình trạng..." />
                    <button type="submit" class="btn btn-primary fw-bold">Tìm kiếm</button>
                </div>
                @if (ViewData["CurrentFilter"] != null && ViewData["CurrentFilter"].ToString() != "")
                {
                    <a asp-action="Index" class="btn btn-outline-danger ms-2 fw-bold"><i class="bi bi-x-circle"></i> Xóa bộ lọc</a>
                }
            </form>

            <div class="table-responsive">
                <table class="table table-hover border align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã TB</th>
                            <th>Tên Thiết Bị</th>
                            <th>Loại Thiết Bị</th>
                            <th>Phòng</th>
                            <th>Số Lượng</th>
                            <th>Tình Trạng</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.MaThietBi</strong></td>
                                    <td>@item.TenThietBi</td>
                                    <td>@item.LoaiThietBi</td>
                                    <td><span class="badge bg-info text-dark fs-6">@item.MaPhong</span></td>
                                    <td>@item.SoLuong</td>
                                    <td>
                                        @if (item.TinhTrang == "Đang sử dụng")
                                        {
                                            <span class="badge bg-success">@item.TinhTrang</span>
                                        }
                                        else if (item.TinhTrang == "Hỏng" || item.TinhTrang == "Mất")
                                        {
                                            <span class="badge bg-danger">@item.TinhTrang</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@item.TinhTrang</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.MaThietBi" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil-square"></i> Sửa</a>
                                        <a asp-action="Details" asp-route-id="@item.MaThietBi" class="btn btn-outline-info btn-sm"><i class="bi bi-info-circle"></i> Chi tiết</a>
                                        <a asp-action="Delete" asp-route-id="@item.MaThietBi" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Không tìm thấy thiết bị nào khớp với từ khóa tìm kiếm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>