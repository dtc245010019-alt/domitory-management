@model QLKTX.Models.Phong

@{
    ViewData["Title"] = "Thêm Phòng Ký Túc Xá Mới";
}

<div class="container-fluid px-0" style="max-width: 850px; margin: 0 auto;">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Danh sách phòng</a>
                <span class="text-muted small">• Thêm phòng</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Thêm Phòng Ký Túc Xá Mới</h2>
            <p class="text-muted small mb-0 mt-1">Khai báo mã phòng, loại phòng, số lượng giường và mức giá lưu trú.</p>
        </div>

        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-x-lg me-1"></i> Hủy & Quay lại
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-xs mb-4">
        <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-door-open-fill text-primary"></i>
                <h5 class="fw-bold text-dark mb-0 fs-6">Thông Tin Chi Tiết Phòng Ở</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="row g-3">
                    
                    <!-- Mã Phòng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="MaPhong" class="form-label">Mã Phòng <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-hash text-muted"></i></span>
                            <input asp-for="MaPhong" class="form-control" placeholder="Ví dụ: A101, B204" required />
                        </div>
                        <span asp-validation-for="MaPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Loại Phòng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="LoaiPhong" class="form-label">Loại Phòng <span class="text-danger">*</span></label>
                        <select asp-for="LoaiPhong" class="form-select" required>
                            <option value="Phòng thường">Phòng thường</option>
                            <option value="Phòng có điều hoà">Phòng có điều hoà</option>
                            <option value="Phòng điều hoà + nóng lạnh">Phòng điều hoà + nóng lạnh</option>
                            <option value="Phòng chất lượng cao">Phòng chất lượng cao</option>
                        </select>
                        <span asp-validation-for="LoaiPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tòa / Khu -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Toa" class="form-label">Tòa / Khu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building text-muted"></i></span>
                            <input asp-for="Toa" class="form-control" placeholder="Ví dụ: Tòa chính, Tòa A1, Tòa B1, Tòa C1" required list="toaOptions" />
                            <datalist id="toaOptions">
                                <option value="Tòa chính" />
                                <option value="Tòa A1" />
                                <option value="Tòa B1" />
                                <option value="Tòa C1" />
                                <option value="Khu A" />
                                <option value="Khu B" />
                                <option value="Khu C" />
                            </datalist>
                        </div>
                        <span asp-validation-for="Toa" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tầng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Tang" class="form-label">Tầng <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-layers text-muted"></i></span>
                            <input asp-for="Tang" type="number" min="1" max="20" class="form-control" placeholder="Số tầng (1-20)" required />
                        </div>
                        <span asp-validation-for="Tang" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tổng Số Giường -->
                    <div class="col-12 col-md-6">
                        <label asp-for="SoLuongGiuong" class="form-label">Tổng Số Giường Quy Định <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-layout-text-window text-muted"></i></span>
                            <input asp-for="SoLuongGiuong" id="soLuongGiuongInput" type="number" min="1" max="16" class="form-control" placeholder="Số giường trong phòng" required />
                        </div>
                        <span asp-validation-for="SoLuongGiuong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Số Giường Đã Có Người Ở -->
                    <div class="col-12 col-md-6">
                        <label for="soGiuongDaOInput" class="form-label">Số Giường Đã Có Người Ở <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-people-fill text-muted"></i></span>
                            <input name="soGiuongDaO" id="soGiuongDaOInput" type="number" min="0" max="16" value="@(ViewBag.SoDangO ?? 0)" class="form-control" placeholder="Nhập số SV đang ở (0 = trống, bằng tổng = đầy)" required />
                        </div>
                        <span id="siSoHelpText" class="text-muted small mt-1 d-block" style="font-size: 0.74rem;">
                            <i class="bi bi-info-circle me-1"></i>Sĩ số: <strong id="siSoBadge" class="text-primary">0/4</strong> (Trống: 0/4 | Còn chỗ: 1/4... | Đã đầy: 4/4)
                        </span>
                    </div>

                    <!-- Giá Phòng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="GiaPhong" class="form-label">Giá Thuê (VNĐ / Tháng) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-cash-stack text-muted"></i></span>
                            <input asp-for="GiaPhong" type="number" step="10000" class="form-control" placeholder="Ví dụ: 650000" required />
                        </div>
                        <span asp-validation-for="GiaPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tình Trạng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="TinhTrang" class="form-label">Tình Trạng Phòng <span class="text-danger">*</span></label>
                        <select asp-for="TinhTrang" id="tinhTrangSelect" class="form-select" required>
                            <option value="Còn chỗ">Còn chỗ</option>
                            <option value="Đã đầy">Đã đầy</option>
                            <option value="Bảo trì">Bảo trì</option>
                            <option value="Đang sửa chữa">Đang sửa chữa</option>
                        </select>
                        <span asp-validation-for="TinhTrang" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Trạng Thái Thiết Bị (Nếu có) -->
                    <div class="col-12 col-md-6">
                        <label asp-for="TrangThaiThietBi" class="form-label">Trạng Thái Thiết Bị</label>
                        <input asp-for="TrangThaiThietBi" class="form-control" placeholder="Ví dụ: Bình thường, Đầy đủ" />
                        <span asp-validation-for="TrangThaiThietBi" class="text-danger small mt-1 d-block"></span>
                    </div>

                </div>

                <!-- Action buttons -->
                <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu Phòng Mới
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const totalInput = document.getElementById('soLuongGiuongInput');
            const occupiedInput = document.getElementById('soGiuongDaOInput');
            const statusSelect = document.getElementById('tinhTrangSelect');
            const badge = document.getElementById('siSoBadge');

            function updateOccupancyUI(source) {
                let total = parseInt(totalInput.value) || 4;
                if (total < 1) total = 1;
                occupiedInput.max = total;

                let occupied = parseInt(occupiedInput.value);
                if (isNaN(occupied) || occupied < 0) occupied = 0;
                if (occupied > total) occupied = total;

                if (source === 'status') {
                    if (statusSelect.value === 'Đã đầy') {
                        occupied = total;
                        occupiedInput.value = occupied;
                    } else if (statusSelect.value === 'Còn chỗ') {
                        if (occupied >= total) {
                            occupied = 0;
                            occupiedInput.value = occupied;
                        }
                    }
                } else if (source === 'occupied') {
                    occupiedInput.value = occupied;
                    if (occupied >= total) {
                        statusSelect.value = 'Đã đầy';
                    } else if (statusSelect.value === 'Đã đầy') {
                        statusSelect.value = 'Còn chỗ';
                    }
                } else if (source === 'total') {
                    if (statusSelect.value === 'Đã đầy') {
                        occupied = total;
                        occupiedInput.value = occupied;
                    } else if (occupied > total) {
                        occupied = total;
                        occupiedInput.value = occupied;
                    }
                }

                if (badge) {
                    let note = (occupied === 0) ? ' (Trống hoàn toàn)' : ((occupied >= total) ? ' (Đã đầy)' : ` (Còn ${total - occupied} chỗ)`);
                    badge.innerText = `${occupied}/${total}${note}`;
                    if (occupied >= total) {
                        badge.className = 'text-danger fw-bold';
                    } else if (occupied === 0) {
                        badge.className = 'text-muted fw-bold';
                    } else {
                        badge.className = 'text-success fw-bold';
                    }
                }
            }

            if (totalInput && occupiedInput && statusSelect) {
                totalInput.addEventListener('input', () => updateOccupancyUI('total'));
                occupiedInput.addEventListener('input', () => updateOccupancyUI('occupied'));
                statusSelect.addEventListener('change', () => updateOccupancyUI('status'));
                updateOccupancyUI('init');
            }
        });
    </script>
}