@model QLKTX.Models.Phong

@{
    ViewData["Title"] = "Cập Nhật Thông Tin Phòng - " + Model.MaPhong;
}

<div class="container-fluid px-0" style="max-width: 850px; margin: 0 auto;">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Danh sách phòng</a>
                <span class="text-muted small">• Chỉnh sửa</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Cập Nhật Phòng @Model.MaPhong</h2>
            <p class="text-muted small mb-0 mt-1">Cập nhật loại phòng, sức chứa giường, đơn giá và trạng thái kỹ thuật.</p>
        </div>

        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-x-lg me-1"></i> Hủy & Quay lại
        </a>
    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-xs mb-4">
        <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary"></i>
                <h5 class="fw-bold text-dark mb-0 fs-6">Chỉnh Sửa Thông Tin Phòng @Model.MaPhong</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <input type="hidden" asp-for="MaPhong" />
                <input type="hidden" asp-for="TrangThaiThietBi" />

                <div class="row g-3">
                    
                    <!-- Mã Phòng (Disabled) -->
                    <div class="col-12 col-md-6">
                        <label class="form-label">Mã Phòng</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-hash text-muted"></i></span>
                            <input class="form-control bg-light font-monospace fw-bold text-primary" value="@Model.MaPhong" disabled />
                        </div>
                        <span class="text-muted small" style="font-size: 0.74rem;">Mã phòng là định danh cố định không thể sửa.</span>
                    </div>

                    <!-- Loại Phòng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="LoaiPhong" class="form-label">Loại Phòng <span class="text-danger">*</span></label>
                        <select asp-for="LoaiPhong" class="form-select" required>
                            <option value="Phòng thường">Phòng thường</option>
                            <option value="Phòng có điều hoà">Phòng có điều hoà</option>
                            <option value="Phòng điều hoà + nóng lạnh">Phòng điều hoà + nóng lạnh</option>
                            <option value="Phòng chất lượng cao">Phòng chất lượng cao</option>
                        </select>
                        <span asp-validation-for="LoaiPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Số Giường -->
                    <div class="col-12 col-md-6">
                        <label asp-for="SoLuongGiuong" class="form-label">Số Lượng Giường <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-layout-text-window text-muted"></i></span>
                            <input asp-for="SoLuongGiuong" type="number" min="1" max="16" class="form-control" required />
                        </div>
                        <span asp-validation-for="SoLuongGiuong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Giá Phòng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="GiaPhong" class="form-label">Giá Thuê (VNĐ / Tháng) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-cash-stack text-muted"></i></span>
                            <input asp-for="GiaPhong" type="number" step="10000" class="form-control" required />
                        </div>
                        <span asp-validation-for="GiaPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tình Trạng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="TinhTrang" class="form-label">Tình Trạng Phòng <span class="text-danger">*</span></label>
                        <select asp-for="TinhTrang" class="form-select" required>
                            <option value="Còn chỗ">Còn chỗ</option>
                            <option value="Đã đầy">Đã đầy</option>
                            <option value="Bảo trì">Bảo trì</option>
                            <option value="Đang sửa chữa">Đang sửa chữa</option>
                        </select>
                        <span asp-validation-for="TinhTrang" class="text-danger small mt-1 d-block"></span>
                    </div>

                </div>

                <!-- Action buttons -->
                <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Cập Nhật Phòng
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}