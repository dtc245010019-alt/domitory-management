<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Thông Tin Sinh Viên KTX</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Portal" asp-action="Index">
                    <div class="brand-icon-box d-inline-block align-middle me-1">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    Cổng SV Ký Túc Xá
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Portal" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Portal" asp-action="HoaDon"><i class="bi bi-receipt"></i> Hóa đơn của tôi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Portal" asp-action="BaoCaoSuCo"><i class="bi bi-tools"></i> Báo cáo sự cố</a>
                        </li>
                    </ul>
                    <div class="navbar-nav d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <div class="d-flex align-items-center gap-2 p-1 pe-2 rounded-pill border bg-white shadow-xs" data-bs-toggle="dropdown" aria-expanded="false" role="button" style="cursor: pointer;">
                                <div class="avatar-ring">
                                    <div class="avatar-inner-box">SV</div>
                                    <span class="avatar-online-dot"></span>
                                </div>
                                <div class="d-none d-md-block text-start lh-1 ps-1">
                                    <div class="fw-bold text-dark" style="font-size: 0.85rem;">Sinh viên</div>
                                    <span class="text-muted" style="font-size: 0.7rem;">Người dùng Portal</span>
                                </div>
                                <i class="bi bi-chevron-down text-muted small ms-1 d-none d-md-inline-block" style="font-size: 0.75rem;"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow-dropdown border-0 rounded-3 mt-1" style="border: 1px solid var(--border-color) !important; min-width: 210px;">
                                <li>
                                    <a class="dropdown-item py-2 text-danger small" asp-controller="DN" asp-action="Dangxuat" onclick="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center mt-5 bg-white">
        <div class="container py-3">
            &copy; 2026 - Cổng Thông Tin Sinh Viên KTX
        </div>
    </footer>

    <!-- ====================================================
         WIDGET CHATBOT AI KTX FLOATING
         ==================================================== -->
    <div id="chat-widget">
        <button type="button" id="chat-toggle-btn" title="Trợ lý AI Ký túc xá" aria-label="Mở Trợ lý AI KTX">
            <i class="bi bi-robot"></i>
            <span style="position: absolute; top: 4px; right: 4px; font-size: 11px;">✨</span>
        </button>

        <div id="chat-box" class="d-none">
            <div class="chat-header-glass">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                        <i class="bi bi-robot text-white"></i>
                    </div>
                    <div>
                        <strong class="d-block small text-white lh-1">Trợ Lý AI KTX</strong>
                        <span class="text-white opacity-75" style="font-size: 0.7rem;">● Trực tuyến 24/7</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" id="chat-close-btn" class="btn btn-sm text-white p-1" style="background: rgba(255,255,255,0.15); border-radius: 6px;" aria-label="Đóng chat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Thanh chuyển 2 chế độ: Nhờ AI làm hộ & Hỏi đáp -->
            <div class="p-1 bg-light border-bottom d-flex gap-1 px-2 pt-2">
                <button type="button" id="mode-btn-action" class="btn btn-sm flex-fill fw-semibold py-1 px-2 rounded-pill text-secondary bg-white border" style="font-size: 0.76rem;" onclick="switchChatMode('ACTION', true)">
                    ⚡ Nhờ AI làm hộ
                </button>
                <button type="button" id="mode-btn-qa" class="btn btn-sm flex-fill fw-bold py-1 px-2 rounded-pill shadow-sm text-white" style="background: linear-gradient(135deg, #0284c7, #2563eb); font-size: 0.76rem;" onclick="switchChatMode('QA', true)">
                    💬 Hỏi đáp
                </button>
            </div>
            <div id="chat-mode-banner" class="px-3 py-1 border-bottom d-flex align-items-center justify-content-between" style="background: #eff6ff; color: #1d4ed8; font-size: 0.72rem;">
                <span>💬 <strong>Chế độ Hỏi đáp:</strong> Đặt câu hỏi để AI tra cứu &amp; liệt kê chi tiết</span>
            </div>

            <div id="chat-messages">
                <div class="msg-row-ai">
                    <div class="msg-bubble-ai">
                        👋 <strong>Xin chào bạn!</strong> Tôi là Trợ Lý AI Tiện ích Sinh viên KTX.<br />
                        Tôi có thể hỗ trợ các tiện ích lưu trú cho bạn:<br />
                        • ⚡ <strong>Nhờ AI làm hộ:</strong> Gõ <em>"báo hỏng thiết bị phòng tôi"</em>, <em>"gia hạn phòng cho tôi"</em>, <em>"xin chuyển phòng"</em>...<br />
                        • 💬 <strong>Tra cứu cá nhân:</strong> Gõ <em>"tôi còn hóa đơn nào chưa thanh toán"</em>, <em>"hợp đồng khi nào hết hạn"</em>, <em>"bạn cùng phòng"</em>...
                    </div>
                </div>
            </div>

            <div id="chat-quick-chips" class="p-2 border-top bg-white d-flex gap-1 overflow-auto" style="scrollbar-width: none;">
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Tôi còn hóa đơn nào chưa thanh toán?', 'QA')">🧾 Hóa đơn chưa thanh toán?</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Hợp đồng của tôi khi nào hết hạn?', 'QA')">📄 Hạn hợp đồng của tôi?</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Phòng tôi hiện có những ai?', 'QA')">👥 Bạn cùng phòng?</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Sự cố phòng tôi đã được xử lý chưa?', 'QA')">🔧 Tiến độ sửa sự cố?</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Phòng tôi có những cơ sở vật chất nào?', 'QA')">🛋 Thiết bị phòng tôi?</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-nowrap" style="font-size: 0.71rem; border-radius: 20px;" onclick="sendQuickPrompt('Tôi có bị vi phạm kỷ luật nào không?', 'QA')">⚠️ Kiểm tra vi phạm?</button>
            </div>

            <div class="p-3 border-top bg-white">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control form-control-sm border bg-light" placeholder="Nhập câu hỏi (VD: tôi còn hóa đơn nào chưa thanh toán?)..." autocomplete="off" />
                    <button type="button" class="btn btn-primary btn-sm px-3" onclick="sendChatMessage()" aria-label="Gửi tin nhắn">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>window.chatUserRole = 'SinhVien';</script>
    <script src="~/js/chatbot-agent.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chatbot Widget Toggle
            const chatToggleBtn = document.getElementById('chat-toggle-btn');
            const chatCloseBtn = document.getElementById('chat-close-btn');
            const chatBox = document.getElementById('chat-box');
            const chatInput = document.getElementById('chat-input');

            function toggleChat() {
                if (!chatBox) return;
                chatBox.classList.toggle('d-none');
                if (!chatBox.classList.contains('d-none') && chatInput) {
                    setTimeout(() => chatInput.focus(), 150);
                }
            }

            function closeChat() {
                if (chatBox) chatBox.classList.add('d-none');
            }

            if (chatToggleBtn) chatToggleBtn.addEventListener('click', toggleChat);
            if (chatCloseBtn) chatCloseBtn.addEventListener('click', closeChat);

            if (chatInput) {
                chatInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendChatMessage();
                    }
                });
            }
        });

        function sendQuickPrompt(text, modeOverride) {
            if (modeOverride && typeof switchChatMode === 'function') {
                switchChatMode(modeOverride, false);
            }
            const chatInput = document.getElementById('chat-input');
            if (chatInput) {
                chatInput.value = text;
                sendChatMessage();
            }
        }

        async function sendChatMessage() {
            const chatInput = document.getElementById('chat-input');
            const chatMessages = document.getElementById('chat-messages');
            if (!chatInput || !chatMessages) return;

            const message = chatInput.value.trim();
            if (!message) return;

            const activeMode = window.currentChatMode || 'QA';
            const modeBadge = activeMode === 'ACTION'
                ? '<span class="badge bg-warning text-dark me-1" style="font-size:0.65rem;">⚡ Làm hộ</span>'
                : '<span class="badge bg-info text-white me-1" style="font-size:0.65rem;">💬 Hỏi đáp</span>';

            chatMessages.innerHTML += `
                <div class="msg-row-user">
                    <div class="msg-bubble-user">${modeBadge}${escapeHtml(message)}</div>
                </div>
            `;
            chatInput.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            const loadingId = 'ai-load-' + Date.now();
            chatMessages.innerHTML += `
                <div id="${loadingId}" class="msg-row-ai">
                    <div class="msg-bubble-ai text-muted small"><i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i>${activeMode === 'ACTION' ? 'AI đang tự động thực thi...' : 'AI đang tra cứu dữ liệu...'}</div>
                </div>
            `;
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message, mode: activeMode, role: 'SinhVien' })
                });
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                const aiText = data.response || "Tôi đã nhận được câu hỏi nhưng chưa có phản hồi phù hợp.";
                const formattedText = typeof formatAiMessageText === 'function' ? formatAiMessageText(aiText) : escapeHtml(aiText).replace(/\n/g, '<br />');
                const cardHtml = (typeof renderActionCard === 'function' && data.actionCard) ? renderActionCard(data.actionCard) : '';
                const quickBtnHtml = (typeof renderQuickActionButton === 'function' && data.quickAction) ? renderQuickActionButton(data.quickAction) : '';
                const src = data.source ? `<div class="mt-1 pt-1 border-top text-muted" style="font-size:0.7rem;"><i class="bi bi-database me-1"></i>📌 Nguồn: ${escapeHtml(data.source)}</div>` : '';
                chatMessages.innerHTML += `
                    <div class="msg-row-ai">
                        <div class="msg-bubble-ai">${formattedText}${cardHtml}${quickBtnHtml}${src}</div>
                    </div>
                `;
            } catch (err) {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();
                chatMessages.innerHTML += `
                    <div class="msg-row-ai">
                        <div class="msg-bubble-ai text-danger small">Lỗi kết nối máy chủ AI (${escapeHtml(err.message)})</div>
                    </div>
                `;
            }
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function escapeHtml(text) {
            const p = document.createElement('p');
            p.textContent = text;
            return p.innerHTML;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>