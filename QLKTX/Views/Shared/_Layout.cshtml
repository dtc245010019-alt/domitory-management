@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var isAdmin = HttpContextAccessor.HttpContext?.Session?.GetString("Admin_DangNhap");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Ký Túc Xá | QLKTX</title>

    <!-- Font Family: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Icon Libraries (Bootstrap Icons + FontAwesome) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Master SaaS Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Mobile Drawer Backdrop -->
    <div class="mobile-backdrop" id="sidebarBackdrop"></div>

    <!-- App Main Flex Layout -->
    <div id="app-wrapper">

        <!-- ====================================================
             1. CỐ ĐỊNH SIDEBAR BÊN TRÁI (WIDTH: 260px)
             ==================================================== -->
        <aside id="app-sidebar">
            
            <!-- Brand / Logo Header -->
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="brand-icon-box">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    <div class="lh-sm">
                        <span class="fw-bold text-white fs-6 d-block tracking-tight">QLKTX</span>
                        <span class="small fw-medium" style="font-size: 0.68rem; color: #818cf8;">Quản trị Ký túc xá</span>
                    </div>
                </a>
                <button class="btn-close btn-close-white d-lg-none" id="sidebarCloseBtn" aria-label="Đóng menu"></button>
            </div>

            <!-- Scrollable Navigation Menu -->
            <div class="sidebar-menu-scroll">
                
                <!-- 1. TỔNG QUAN -->
                <div class="menu-header-label">Tổng quan</div>
                <ul class="sidebar-nav-list">
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="sidebar-nav-item @((currentController == "Home" || currentController == "") && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill nav-icon"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="BaoCao" asp-action="Index" class="sidebar-nav-item @(currentController == "BaoCao" ? "active" : "")">
                            <i class="bi bi-graph-up-arrow nav-icon"></i>
                            <span>Báo cáo & Thống kê</span>
                        </a>
                    </li>
                </ul>

                <!-- 2. QUẢN LÝ LƯU TRÚ -->
                <div class="menu-header-label">Quản lý Lưu trú</div>
                <ul class="sidebar-nav-list">
                    <li>
                        <a asp-controller="SinhVien" asp-action="Index" class="sidebar-nav-item @(currentController == "SinhVien" && currentAction != "LichSu" ? "active" : "")">
                            <i class="bi bi-people-fill nav-icon"></i>
                            <span>Sinh viên KTX</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="SinhVien" asp-action="LichSu" class="sidebar-nav-item @(currentController == "SinhVien" && currentAction == "LichSu" ? "active" : "")">
                            <i class="bi bi-clock-history nav-icon"></i>
                            <span>Lịch sử sinh viên</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Phong" asp-action="Index" class="sidebar-nav-item @(currentController == "Phong" ? "active" : "")">
                            <i class="bi bi-door-open-fill nav-icon"></i>
                            <span>Quản lý Phòng ở</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="HopDong" asp-action="Index" class="sidebar-nav-item @(currentController == "HopDong" ? "active" : "")">
                            <i class="bi bi-file-earmark-text-fill nav-icon"></i>
                            <span>Hợp đồng lưu trú</span>
                        </a>
                    </li>
                </ul>

                <!-- 3. TÀI SẢN & DỊCH VỤ -->
                <div class="menu-header-label">Tài sản & Dịch vụ</div>
                <ul class="sidebar-nav-list">
                    <li>
                        <a asp-controller="CoSoVatChat" asp-action="Index" class="sidebar-nav-item @(currentController == "CoSoVatChat" ? "active" : "")">
                            <i class="bi bi-box-seam-fill nav-icon"></i>
                            <span>Cơ sở vật chất</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Portal" asp-action="QuanLyHoaDonAdmin" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "QuanLyHoaDonAdmin" ? "active" : "")">
                            <i class="bi bi-lightning-charge-fill nav-icon"></i>
                            <span>Điện nước & Hóa đơn</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Portal" asp-action="QuanLySuCoAdmin" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "QuanLySuCoAdmin" ? "active" : "")">
                            <i class="bi bi-tools nav-icon"></i>
                            <span>Báo cáo sự cố</span>
                        </a>
                    </li>
                </ul>

                <!-- 4. KỶ LUẬT & NỘI QUY -->
                <div class="menu-header-label">Kỷ luật & Nội quy</div>
                <ul class="sidebar-nav-list">
                    <li>
                        <a asp-controller="ViPham" asp-action="Index" class="sidebar-nav-item @(currentController == "ViPham" ? "active" : "")">
                            <i class="bi bi-shield-fill-exclamation nav-icon"></i>
                            <span>Vi phạm & Xử lý</span>
                        </a>
                    </li>
                </ul>

                <!-- 5. HỆ THỐNG & CỔNG THÔNG TIN -->
                <div class="menu-header-label">Cổng thông tin & Hỗ trợ</div>
                <ul class="sidebar-nav-list">
                    <li>
                        <a asp-controller="Portal" asp-action="Index" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-person-badge-fill nav-icon"></i>
                            <span>Cổng Sinh viên (Portal)</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="DN" asp-action="LienheQuanly" class="sidebar-nav-item @(currentController == "DN" && currentAction == "LienheQuanly" ? "active" : "")">
                            <i class="bi bi-headset nav-icon"></i>
                            <span>Hỗ trợ kỹ thuật</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="DN" asp-action="Dangxuat" class="sidebar-nav-item text-danger" onclick="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?');">
                            <i class="bi bi-box-arrow-right nav-icon text-danger"></i>
                            <span class="text-danger fw-semibold">Đăng xuất</span>
                        </a>
                    </li>
                </ul>

            </div>

            <!-- Footer Sidebar Status -->
            <div class="sidebar-system-footer">
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex align-items-center gap-2 small text-light">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--success); display: inline-block; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);"></span>
                        <span style="font-size: 0.75rem;">Hệ thống Online</span>
                    </div>
                    <span class="badge bg-secondary opacity-75 font-monospace" style="font-size: 0.65rem;">v3.2</span>
                </div>
            </div>
        </aside>

        <!-- ====================================================
             2. VÙNG NỘI DUNG CHÍNH (MAIN WRAPPER BÊN PHẢI)
             ==================================================== -->
        <div id="main-content-wrapper">
            
            <!-- Sticky SaaS Topbar Header -->
            <header id="app-topbar">
                
                <!-- Left: Hamburger button (mobile) + Global Quick Search -->
                <div class="d-flex align-items-center gap-3 flex-grow-1">
                    <button class="btn btn-light btn-sm d-lg-none" id="sidebarToggleBtn" title="Mở danh mục menu" aria-label="Mở menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <!-- Quick Global Search Input -->
                    <form method="get" asp-controller="SinhVien" asp-action="Index" class="position-relative d-none d-sm-block w-100" style="max-width: 380px;">
                        <i class="bi bi-search text-muted position-absolute" style="left: 1rem; top: 50%; transform: translateY(-50%); font-size: 0.85rem;"></i>
                        <input type="text" name="searchString" id="topbarSearchInput" class="topbar-search-input" placeholder="Tìm sinh viên, phòng ở, hợp đồng..." autocomplete="off" />
                        <span class="position-absolute text-muted small fw-bold px-2 py-0 bg-white rounded shadow-xs" style="right: 0.75rem; top: 50%; transform: translateY(-50%); font-size: 0.68rem; border: 1px solid var(--border-color);">Ctrl+K</span>
                    </form>
                </div>

                <!-- Right: Quick Actions, Notifications & User Avatar -->
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    
                    <!-- Notification Bell Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="bell-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo hệ thống">
                            <i class="bi bi-bell"></i>
                            <span class="bell-dot">3</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow-dropdown border-0 rounded-4 p-0" style="width: 320px; border: 1px solid var(--border-color) !important;">
                            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-surface-subtle">
                                <span class="fw-bold small text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Thông báo mới</span>
                                <span class="badge bg-primary rounded-pill small">3 chưa đọc</span>
                            </div>
                            <div class="p-2" style="max-height: 260px; overflow-y: auto;">
                                <a href="@Url.Action("QuanLySuCoAdmin", "Portal")" class="d-flex gap-2 p-2 rounded-3 text-decoration-none text-dark hover-bg-light">
                                    <div class="p-2 rounded-3" style="width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; background-color: var(--danger-bg); color: var(--danger-text);">
                                        <i class="bi bi-tools"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-semibold">Báo cáo sự cố P.302</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">Hỏng vòi nước • 15 phút trước</div>
                                    </div>
                                </a>
                                <a href="@Url.Action("Index", "HopDong")" class="d-flex gap-2 p-2 rounded-3 text-decoration-none text-dark hover-bg-light">
                                    <div class="p-2 rounded-3" style="width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; background-color: var(--warning-bg); color: var(--warning-text);">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-semibold">2 hợp đồng sắp hết hạn</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">Cần gia hạn lưu trú • 1 giờ trước</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile Dropdown -->
                    @{
                        if (isAdmin == "true")
                        {
                            <div class="dropdown">
                                <div class="d-flex align-items-center gap-2 p-1 pe-2 rounded-pill border bg-white shadow-xs" data-bs-toggle="dropdown" aria-expanded="false" role="button" style="cursor: pointer;">
                                    <div class="avatar-ring">
                                        <div class="avatar-inner-box">AD</div>
                                        <span class="avatar-online-dot"></span>
                                    </div>
                                    <div class="d-none d-md-block text-start lh-1 ps-1">
                                        <div class="fw-bold text-dark" style="font-size: 0.85rem;">Ban Quản Lý</div>
                                        <span class="text-muted" style="font-size: 0.7rem;">Admin KTX</span>
                                    </div>
                                    <i class="bi bi-chevron-down text-muted small ms-1 d-none d-md-inline-block" style="font-size: 0.75rem;"></i>
                                </div>
                                <ul class="dropdown-menu dropdown-menu-end shadow-dropdown border-0 rounded-3 mt-1" style="border: 1px solid var(--border-color) !important; min-width: 210px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark small">Admin Quản Trị</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">admin@dormitory.edu.vn</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 small" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-speedometer2 text-muted me-2"></i>Bảng điều khiển
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 small" asp-controller="Portal" asp-action="Index">
                                            <i class="bi bi-mortarboard text-muted me-2"></i>Xem Cổng Sinh viên
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger small" asp-controller="DN" asp-action="Dangxuat" onclick="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="DN" asp-action="Dangnhap" class="btn btn-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </a>
                        }
                    }

                </div>
            </header>

            <!-- Global Auto-Dismiss Notification Container -->
            <div class="px-3 px-md-4 pt-3">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss="4000">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss="6000">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["AlertMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div class="flex-grow-1">@TempData["AlertMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <!-- Main Render Area -->
            <main role="main" class="flex-grow-1 p-3 p-md-4 pt-2">
                @RenderBody()
            </main>

            <!-- SaaS Admin Minimal Footer -->
            <footer class="bg-white border-top py-3 px-4 text-muted small mt-auto">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <div>
                        &copy; 2026 <strong class="text-dark">QLKTX</strong> - Hệ Thống Quản Lý Ký Túc Xá Sinh Viên.
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Chính sách</a>
                        <a asp-controller="DN" asp-action="LienheQuanly" class="text-muted text-decoration-none">Hỗ trợ kỹ thuật</a>
                        <span class="badge bg-light text-muted border font-monospace">ASP.NET Core 8</span>
                    </div>
                </div>
            </footer>

        </div>
    </div>

    <!-- ====================================================
         3. WIDGET CHATBOT AI KTX FLOATING
         ==================================================== -->
    <div id="chat-widget">
        <button type="button" id="chat-toggle-btn" title="Trợ lý AI Ký túc xá" aria-label="Mở Trợ lý AI KTX">
            <i class="bi bi-robot"></i>
            <span style="position: absolute; top: 4px; right: 4px; font-size: 11px;">✨</span>
        </button>

        <div id="chat-box" class="d-none">
            <div class="chat-header-glass">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                        <i class="bi bi-robot text-white"></i>
                    </div>
                    <div>
                        <strong class="d-block small text-white lh-1">Trợ Lý AI KTX</strong>
                        <span class="text-white opacity-75" style="font-size: 0.7rem;">● Trực tuyến 24/7</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" id="chat-close-btn" class="btn btn-sm text-white p-1" style="background: rgba(255,255,255,0.15); border-radius: 6px;" aria-label="Đóng chat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div id="chat-messages">
                <div class="msg-row-ai">
                    <div class="msg-bubble-ai">
                        👋 <strong>Xin chào!</strong> Tôi là Trợ Lý AI của Ký túc xá.<br />
                        Bạn có câu hỏi gì về phòng ở, hợp đồng, chi phí điện nước hay thủ tục báo hỏng?
                    </div>
                </div>
            </div>

            <div class="p-2 border-top bg-white d-flex gap-1 overflow-auto" style="scrollbar-width: none;">
                <button type="button" class="btn btn-sm btn-light py-1 px-2 text-nowrap" style="font-size: 0.72rem; border-radius: 20px;" onclick="sendQuickPrompt('Giá phòng KTX bao nhiêu?')">💰 Giá phòng?</button>
                <button type="button" class="btn btn-sm btn-light py-1 px-2 text-nowrap" style="font-size: 0.72rem; border-radius: 20px;" onclick="sendQuickPrompt('Hướng dẫn báo hỏng cơ sở vật chất?')">🛠 Báo sự cố?</button>
                <button type="button" class="btn btn-sm btn-light py-1 px-2 text-nowrap" style="font-size: 0.72rem; border-radius: 20px;" onclick="sendQuickPrompt('Quy định giờ giấc ký túc xá?')">⏰ Giờ giới nghiêm?</button>
            </div>

            <div class="p-3 border-top bg-white">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control form-control-sm border bg-light" placeholder="Nhập câu hỏi... (Enter để gửi)" autocomplete="off" />
                    <button type="button" class="btn btn-primary btn-sm px-3" onclick="sendChatMessage()" aria-label="Gửi tin nhắn">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar Mobile Toggle
            const sidebar = document.getElementById('app-sidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const backdrop = document.getElementById('sidebarBackdrop');
            const searchInput = document.getElementById('topbarSearchInput');

            function toggleSidebar() {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            // Shortcut Ctrl + K for search
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    if (searchInput) searchInput.focus();
                }
            });

            // Auto-dismiss Alerts
            document.querySelectorAll('.alert[data-auto-dismiss]').forEach(function (alertElem) {
                const duration = parseInt(alertElem.getAttribute('data-auto-dismiss')) || 4000;
                setTimeout(function () {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alertElem);
                    if (bsAlert) bsAlert.close();
                }, duration);
            });

            // Chatbot Widget Toggle
            const chatToggleBtn = document.getElementById('chat-toggle-btn');
            const chatCloseBtn = document.getElementById('chat-close-btn');
            const chatBox = document.getElementById('chat-box');
            const chatInput = document.getElementById('chat-input');

            function toggleChat() {
                if (!chatBox) return;
                chatBox.classList.toggle('d-none');
                if (!chatBox.classList.contains('d-none') && chatInput) {
                    setTimeout(() => chatInput.focus(), 150);
                }
            }

            function closeChat() {
                if (chatBox) chatBox.classList.add('d-none');
            }

            if (chatToggleBtn) chatToggleBtn.addEventListener('click', toggleChat);
            if (chatCloseBtn) chatCloseBtn.addEventListener('click', closeChat);

            if (chatInput) {
                chatInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendChatMessage();
                    }
                });
            }
        });

        function sendQuickPrompt(text) {
            const chatInput = document.getElementById('chat-input');
            if (chatInput) {
                chatInput.value = text;
                sendChatMessage();
            }
        }

        async function sendChatMessage() {
            const chatInput = document.getElementById('chat-input');
            const chatMessages = document.getElementById('chat-messages');
            if (!chatInput || !chatMessages) return;

            const message = chatInput.value.trim();
            if (!message) return;

            chatMessages.innerHTML += `
                <div class="msg-row-user">
                    <div class="msg-bubble-user">${escapeHtml(message)}</div>
                </div>
            `;
            chatInput.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            const loadingId = 'ai-load-' + Date.now();
            chatMessages.innerHTML += `
                <div id="${loadingId}" class="msg-row-ai">
                    <div class="msg-bubble-ai text-muted small"><i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i>Đang xử lý...</div>
                </div>
            `;
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                const aiText = data.response || "Tôi đã nhận được câu hỏi nhưng chưa có phản hồi phù hợp.";
                const src = data.source ? `<div class="mt-1 pt-1 border-top text-muted" style="font-size:0.7rem;"><i class="bi bi-database me-1"></i>Nguồn: ${escapeHtml(data.source)}</div>` : '';
                chatMessages.innerHTML += `
                    <div class="msg-row-ai">
                        <div class="msg-bubble-ai">${escapeHtml(aiText).replace(/\n/g, '<br />')}${src}</div>
                    </div>
                `;
            } catch (err) {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();
                chatMessages.innerHTML += `
                    <div class="msg-row-ai">
                        <div class="msg-bubble-ai text-danger small">Lỗi kết nối máy chủ AI (${escapeHtml(err.message)})</div>
                    </div>
                `;
            }
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function escapeHtml(text) {
            const p = document.createElement('p');
            p.textContent = text;
            return p.innerHTML;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>