@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Ký Túc Xá</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building"></i> QL Ký Túc Xá
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="SinhVien" asp-action="Index"><i class="bi bi-people"></i> Sinh viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Phong" asp-action="Index"><i class="bi bi-door-open"></i> Phòng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="HopDong" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Hợp đồng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="CoSoVatChat" asp-action="Index"><i class="bi bi-pc-display"></i> Cơ sở vật chất</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="ViPham" asp-action="Index"><i class="bi bi-shield-exclamation"></i> Kỷ luật</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="BaoCao" asp-action="Index"><i class="bi bi-bar-chart"></i> Thống kê</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @{
                            // 1. Kiểm tra đúng tên thẻ Admin_DangNhap
                            var isAdmin = HttpContextAccessor.HttpContext.Session.GetString("Admin_DangNhap");
                            if (isAdmin == "true")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle"></i> Xin chào, <strong>Admin</strong>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Cài đặt</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="DN" asp-action="Dangxuat"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-bold" asp-controller="DN" asp-action="Dangnhap">Đăng nhập</a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 bg-white">
        <div class="container text-center py-3">
            &copy; 2026 - Hệ thống Quản lý Ký túc xá - <a asp-area="" asp-controller="Home" asp-action="Privacy">Bảo mật</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.css"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- Bong bóng Chatbot -->
<div id="chat-widget" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
    <button id="chat-toggle-btn" class="btn btn-primary rounded-circle shadow p-0" style="width: 50px; height: 50px; font-size: 22px;">💬</button>

    <div id="chat-box" class="card shadow d-none mt-2" style="width: 320px; height: 420px; position: absolute; bottom: 60px; right: 0;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
            <strong>🤖 Trợ Lý AI KTX</strong>
            <button id="chat-close-btn" class="btn btn-sm text-white p-0">✕</button>
        </div>
        <div id="chat-messages" class="card-body overflow-auto p-2" style="height: 310px; background-color: #f8f9fa;">
            <div class="mb-2"><span class="d-inline-block p-2 rounded bg-white shadow-sm border small">Xin chào! Bạn cần trợ giúp gì về KTX? 😊</span></div>
        </div>
        <div class="card-footer p-2 bg-white">
            <div class="input-group">
                <input type="text" id="chat-input" class="form-control form-control-sm" placeholder="Nhập câu hỏi..." onkeydown="if(event.key==='Enter') sendChatMessage()">
                <button class="btn btn-primary btn-sm" onclick="sendChatMessage()">Gửi</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('chat-toggle-btn').onclick = () => document.getElementById('chat-box').classList.toggle('d-none');
    document.getElementById('chat-close-btn').onclick = () => document.getElementById('chat-box').classList.add('d-none');

    async function sendChatMessage() {
        let input = document.getElementById('chat-input');
        let msg = input.value.trim();
        if (!msg) return;

        let chatMsgs = document.getElementById('chat-messages');
        chatMsgs.innerHTML += `<div class="mb-2 text-end"><span class="d-inline-block p-2 rounded bg-primary text-white shadow-sm small">${msg}</span></div>`;
        input.value = '';
        chatMsgs.scrollTop = chatMsgs.scrollHeight;

        let loadingId = 'load-' + Date.now();
        chatMsgs.innerHTML += `<div id="${loadingId}" class="mb-2 text-start"><span class="d-inline-block p-2 rounded bg-white shadow-sm border text-muted small">Đang suy nghĩ... 🤔</span></div>`;
        chatMsgs.scrollTop = chatMsgs.scrollHeight;

        try {
            let res = await fetch('/Chatbot/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            if (!res.ok) {
                throw new Error('HTTP ' + res.status);
            }
            let data = await res.json();
            document.getElementById(loadingId).remove();
            chatMsgs.innerHTML += `<div class="mb-2 text-start"><span class="d-inline-block p-2 rounded bg-white shadow-sm border small">${data.response}${data.source ? `<br><small class="text-muted">📌 Nguồn: ${data.source}</small>` : ''}</span></div>`;
        } catch (err) {
            console.error('Chatbot fetch error:', err);
            document.getElementById(loadingId).remove();
            chatMsgs.innerHTML += `<div class="mb-2 text-start"><span class="d-inline-block p-2 rounded bg-danger text-white small">Lỗi kết nối! (${err.message}) — mở Console (F12) để xem chi tiết.</span></div>`;
        }
        chatMsgs.scrollTop = chatMsgs.scrollHeight;
    }
</script>
</body>
</html>