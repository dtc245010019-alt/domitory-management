@model IEnumerable<QLKTX.Models.BaoCaoSuCo>
@{
    ViewData["Title"] = "Báo Cáo Sự Cố";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mt-3 g-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-exclamation-triangle-fill"></i> TẠO BÁO CÁO MỚI
            </div>
            <div class="card-body">
                <form asp-action="GuiBaoCao" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên sự cố (Ngắn gọn):</label>
                        <input type="text" name="TenSuCo" class="form-control" placeholder="VD: Hỏng vòi nước, Cháy bóng đèn..." required maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mức độ khẩn cấp:</label>
                        <select name="MucDoKhanCap" class="form-select">
                            <option value="Bình thường">Bình thường</option>
                            <option value="Nghiêm trọng">Nghiêm trọng (Ảnh hưởng sinh hoạt)</option>
                            <option value="Khẩn cấp">Khẩn cấp (Nguy hiểm/Chập điện)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết:</label>
                        <textarea name="MoTa" class="form-control" rows="4" placeholder="Mô tả rõ tình trạng để kỹ thuật viên chuẩn bị dụng cụ..." required></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Đính kèm hình ảnh minh họa:</label>
                        <input type="file" name="HinhAnhFile" class="form-control" accept="image/png, image/jpeg, image/jpg" />
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold">
                        <i class="bi bi-send-fill"></i> Gửi Ban Quản Lý
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-secondary">
            <div class="card-header bg-secondary text-white fw-bold">
                <i class="bi bi-clock-history"></i> LỊCH SỬ BÁO CÁO CỦA PHÒNG
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <li class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0 text-primary">@item.TenSuCo</h6>
                                    @if (item.TrangThai == "Đã xử lý")
                                    {
                                        <span class="badge bg-success">Đã xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    }
                                </div>
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-calendar-event"></i> @item.NgayBaoCao.ToString("dd/MM/yyyy HH:mm") |
                                    <span class="text-danger"><i class="bi bi-exclamation-circle"></i> @item.MucDoKhanCap</span>
                                </p>
                                <p class="mb-2">@item.MoTa</p>

                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="@item.HinhAnh" alt="Ảnh sự cố" class="img-thumbnail mt-2" style="max-height: 150px; border-radius: 8px;" />
                                }
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4">Chưa có sự cố nào được ghi nhận.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>