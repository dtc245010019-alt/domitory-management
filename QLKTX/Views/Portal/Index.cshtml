@model QLKTX.Models.SinhVien

@{
    ViewData["Title"] = "Trang cá nhân";
    // ÉP DÙNG LAYOUT CỦA SINH VIÊN
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card shadow-sm border-success h-100">
            <div class="card-header bg-success text-white fw-bold">
                <i class="bi bi-person-vcard"></i> THẺ LƯU TRÚ
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.AnhThe))
                {
                    <img src="@Model.AnhThe" class="img-thumbnail rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png';" />
                }
                else
                {
                    <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="img-thumbnail rounded-circle mb-3" style="width: 120px;" />
                }
                <h5 class="fw-bold text-success">@Model.HoTen</h5>
                <p class="text-muted mb-1">Mã SV: <strong>@Model.MaSV</strong></p>
                <p class="text-muted mb-3">Lớp: <strong>@Model.Lop</strong></p>

                <span class="badge bg-success fs-6 px-3 py-2">Trạng thái: @Model.TinhTrangLuuTru</span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold text-success border-bottom-0">
                <i class="bi bi-door-open"></i> THÔNG TIN PHÒNG HIỆN TẠI
            </div>
            <div class="card-body">
                @if (Model.Phong != null)
                {
                    <div class="row text-center mb-4">
                        <div class="col-sm-4 mb-3">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <h6 class="text-muted">Phòng</h6>
                                <h2 class="fw-bold text-success mb-0">@Model.Phong.MaPhong</h2>
                            </div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <h6 class="text-muted">Loại phòng</h6>
                                <h5 class="fw-bold mb-0 mt-2">@Model.Phong.LoaiPhong</h5>
                            </div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <h6 class="text-muted">Giá phòng/Tháng</h6>
                                <h5 class="fw-bold text-danger mb-0 mt-2">@Model.Phong.GiaPhong.ToString("N0")đ</h5>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold border-bottom pb-2">Hành động nhanh</h6>
                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="HoaDon" class="btn btn-outline-success"><i class="bi bi-receipt"></i> Xem hóa đơn tháng này</a>
                        <a asp-action="BaoCaoSuCo" class="btn btn-outline-danger"><i class="bi bi-tools"></i> Báo hỏng thiết bị</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        <i class="bi bi-exclamation-triangle fs-4 d-block mb-2"></i>
                        Bạn hiện chưa được xếp vào phòng nào trong hệ thống Ký túc xá. Vui lòng liên hệ Ban quản lý.
                    </div>
                }
            </div>
        </div>
    </div>
</div>