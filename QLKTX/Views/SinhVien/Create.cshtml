@model QLKTX.Models.SinhVien

@{
    ViewData["Title"] = "Tiếp Nhận Sinh Viên Mới";
}

<div class="container-fluid px-0" style="max-width: 900px; margin: 0 auto;">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Danh sách sinh viên</a>
                <span class="text-muted small">• Tiếp nhận</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Tiếp Nhận Sinh Viên Mới</h2>
            <p class="text-muted small mb-0 mt-1">Nhập đầy đủ thông tin cá nhân và xếp phòng lưu trú ký túc xá.</p>
        </div>

        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-x-lg me-1"></i> Hủy & Quay lại
        </a>
    </div>

    <!-- Main Form Card -->
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <!-- Group 1: Thông tin cá nhân & Học tập -->
        <div class="card border-0 shadow-xs mb-4">
            <div class="card-header bg-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill text-primary"></i>
                    <h5 class="fw-bold text-dark mb-0 fs-6">1. Thông Tin Cá Nhân & Học Tập</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    
                    <!-- Mã Sinh Viên -->
                    <div class="col-12 col-md-6">
                        <label asp-for="MaSV" class="form-label">Mã Sinh Viên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-heading text-muted"></i></span>
                            <input asp-for="MaSV" class="form-control" placeholder="Ví dụ: SV2026001" required />
                        </div>
                        <span asp-validation-for="MaSV" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Họ và Tên -->
                    <div class="col-12 col-md-6">
                        <label asp-for="HoTen" class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="HoTen" class="form-control" placeholder="Nhập đầy đủ họ tên..." required />
                        </div>
                        <span asp-validation-for="HoTen" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ngày Sinh -->
                    <div class="col-12 col-md-6">
                        <label asp-for="NgaySinh" class="form-label">Ngày Sinh <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar-event text-muted"></i></span>
                            <input asp-for="NgaySinh" type="date" class="form-control" required />
                        </div>
                        <span asp-validation-for="NgaySinh" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Lớp -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Lop" class="form-label">Lớp / Khoa <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-mortarboard text-muted"></i></span>
                            <input asp-for="Lop" class="form-control" placeholder="Ví dụ: KTPM-K20A" required />
                        </div>
                        <span asp-validation-for="Lop" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- CCCD / Định danh -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CCCD" class="form-label">Căn cước công dân (CCCD)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-vcard text-muted"></i></span>
                            <input asp-for="CCCD" class="form-control" placeholder="Nhập 12 số CCCD" />
                        </div>
                        <span asp-validation-for="CCCD" class="text-danger small mt-1 d-block"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Group 2: Liên lạc & Xếp phòng lưu trú -->
        <div class="card border-0 shadow-xs mb-4">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-door-open-fill text-primary"></i>
                    <h5 class="fw-bold text-dark mb-0 fs-6">2. Thông Tin Liên Lạc & Xếp Phòng Ở</h5>
                </div>
                <button type="button" id="btnToggleAiBox" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-stars me-1"></i> AI Gợi ý phòng trống tối ưu
                </button>
            </div>
            <div class="card-body p-4">
                <!-- Khung AI Gợi ý xếp phòng trực tiếp -->
                <div id="aiSuggestPanel" class="p-3 mb-3 rounded-3 border bg-light d-none">
                    <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
                        <div>
                            <label class="form-label small fw-semibold mb-1">Loại phòng ưu tiên</label>
                            <select id="aiLoaiPhongSv" class="form-select form-select-sm">
                                <option value="">-- Tất cả loại phòng --</option>
                                <option value="Phòng thường">Phòng thường (9.000.000đ)</option>
                                <option value="Phòng có điều hoà">Phòng có điều hoà (11.000.000đ)</option>
                                <option value="Phòng điều hoà + nóng lạnh">Phòng điều hoà + nóng lạnh (13.000.000đ)</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold mb-1">Tầng ưu tiên</label>
                            <select id="aiTangSv" class="form-select form-select-sm">
                                <option value="">-- Tất cả Tầng --</option>
                                <option value="1">Tầng 1</option>
                                <option value="2">Tầng 2</option>
                                <option value="3">Tầng 3</option>
                                <option value="4">Tầng 4</option>
                                <option value="5">Tầng 5</option>
                            </select>
                        </div>
                        <button type="button" id="btnRunAiSv" class="btn btn-primary btn-sm">
                            <i class="bi bi-magic me-1"></i> Phân tích & Tự động chọn
                        </button>
                    </div>
                    <div id="aiQuickButtons" class="d-flex flex-wrap gap-2 mb-2"></div>
                    <div id="aiResultTextSv" class="small text-dark bg-white p-2 rounded border d-none" style="white-space: pre-line;"></div>
                </div>

                <div class="row g-3">
                    
                    <!-- Số điện thoại -->
                    <div class="col-12 col-md-4">
                        <label asp-for="SoDienThoai" class="form-label">Số Điện Thoại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone text-muted"></i></span>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" required />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Xếp phòng -->
                    <div class="col-12 col-md-4">
                        <label asp-for="MaPhong" class="form-label">Xếp Vào Phòng (Còn chỗ)</label>
                        <select asp-for="MaPhong" id="selectMaPhongSv" class="form-select" asp-items="ViewBag.Phongs">
                            <option value="">-- Chọn phòng KTX --</option>
                        </select>
                        <span asp-validation-for="MaPhong" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tình trạng lưu trú -->
                    <div class="col-12 col-md-4">
                        <label asp-for="TinhTrangLuuTru" class="form-label">Tình Trạng Lưu Trú</label>
                        <select asp-for="TinhTrangLuuTru" class="form-select">
                            <option value="Đang ở">Đang ở</option>
                            <option value="Đã rời đi">Đã rời đi</option>
                            <option value="Đình chỉ">Đình chỉ</option>
                        </select>
                        <span asp-validation-for="TinhTrangLuuTru" class="text-danger small mt-1 d-block"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Form Actions Footer -->
        <div class="d-flex align-items-center justify-content-end gap-2 mb-5">
            <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i> Lưu Hồ Sơ Sinh Viên
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnToggle = document.getElementById('btnToggleAiBox');
            const panel = document.getElementById('aiSuggestPanel');
            const btnRun = document.getElementById('btnRunAiSv');
            const resultText = document.getElementById('aiResultTextSv');
            const quickButtons = document.getElementById('aiQuickButtons');
            const selectPhong = document.getElementById('selectMaPhongSv');

            if (btnToggle && panel) {
                btnToggle.addEventListener('click', function () {
                    panel.classList.toggle('d-none');
                });
            }

            if (btnRun) {
                btnRun.addEventListener('click', async function () {
                    const loaiPhong = document.getElementById('aiLoaiPhongSv').value;
                    const tangOrToa = document.getElementById('aiTangSv').value;

                    btnRun.disabled = true;
                    btnRun.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang phân tích...';
                    resultText.classList.remove('d-none');
                    resultText.textContent = 'AI đang kiểm tra số giường trống thực tế trong CSDL...';
                    quickButtons.innerHTML = '';

                    try {
                        const res = await fetch('/Phong/GoiYXepPhongAI', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ loaiPhong, tangOrToa, soGiuongCan: 1 })
                        });
                        const data = await res.json();
                        resultText.textContent = data.suggestion || 'Không có gợi ý.';

                        if (data.recommendedMaPhong && selectPhong) {
                            selectPhong.value = data.recommendedMaPhong;
                        }

                        if (Array.isArray(data.recommendedRooms)) {
                            data.recommendedRooms.forEach(function (r) {
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'btn btn-sm btn-success';
                                btn.innerHTML = `<i class="bi bi-check2-circle me-1"></i>Chọn P.${r.maPhong} (Trống ${r.giuongTrong}/${r.soLuongGiuong})`;
                                btn.addEventListener('click', function () {
                                    if (selectPhong) selectPhong.value = r.maPhong;
                                });
                                quickButtons.appendChild(btn);
                            });
                        }
                    } catch (e) {
                        resultText.textContent = 'Không thể kết nối dịch vụ gợi ý phòng.';
                    } finally {
                        btnRun.disabled = false;
                        btnRun.innerHTML = '<i class="bi bi-magic me-1"></i> Phân tích & Tự động chọn';
                    }
                });
            }
        });
    </script>
}
