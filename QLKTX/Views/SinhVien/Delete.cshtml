@model QLKTX.Models.SinhVien

@{
    ViewData["Title"] = "Xóa Sinh Viên";
}

<div class="container-fluid mt-4">
    <div class="card shadow border-danger" style="max-width: 600px; margin: auto;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">CẢNH BÁO XÓA SINH VIÊN</h4>
        </div>
        <div class="card-body text-center">
            <div class="alert alert-warning" role="alert">
                <strong>Bạn có chắc chắn muốn xóa sinh viên này khỏi hệ thống?</strong><br />
                Hành động này không thể hoàn tác!
            </div>

            <h5 class="mt-3">@Model.HoTen - @Model.MaSV</h5>
            <p class="text-muted">Lớp: @Model.Lop | Phòng: @(Model.Phong?.MaPhong ?? "N/A")</p>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="MaSV" />
                <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>