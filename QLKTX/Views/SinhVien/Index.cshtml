@model IEnumerable<QLKTX.Models.SinhVien>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Danh sách Sinh viên";
    var totalSv = Model?.Count() ?? 0;
    bool isKeToan = Context.Session.GetString("VaiTro") == "KeToan";
}

<div class="container-fluid px-0">

    <!-- Header Tiêu đề & Nút Thêm mới -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary rounded-pill">QUẢN LÝ SINH VIÊN</span>
                <span class="text-muted small">• Ký Túc Xá</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Hồ Sơ Sinh Viên Lưu Trú</h2>
            <p class="text-muted small mb-0 mt-1">Quản lý hồ sơ, tình trạng lưu trú, thông tin liên lạc và phòng ở của sinh viên.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportToExcel" class="btn btn-outline-success btn-sm px-3">
                <i class="bi bi-file-earmark-arrow-down-fill me-1"></i> Xuất Excel
            </a>
            @if (!isKeToan)
            {
                <button class="btn btn-light btn-sm px-3" type="button" data-bs-toggle="collapse" data-bs-target="#excelImportCollapse" aria-expanded="false" aria-controls="excelImportCollapse">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Import Excel
                </button>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm sinh viên mới
                </a>
            }
        </div>
    </div>

    <!-- Khối Import Excel (Gọn gàng, trung tính, có thể thu gọn/mở rộng) -->
    @if (!isKeToan)
    {
        <div class="collapse mb-4" id="excelImportCollapse">
            <div class="card border shadow-xs bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-success fs-5"></i>
                        <span class="fw-bold text-dark small">Nhập dữ liệu hàng loạt từ file Excel (.xlsx)</span>
                    </div>
                    <a asp-action="DownloadTemplate" asp-controller="SinhVien" class="btn btn-light btn-sm">
                        <i class="bi bi-download me-1"></i> Tải file Excel mẫu
                    </a>
                </div>
                <div class="card-body px-4 py-3">
                    <form asp-action="ImportExcel" asp-controller="SinhVien" method="post" enctype="multipart/form-data">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-8 col-lg-6">
                                <input type="file" name="fileExcel" class="form-control form-control-sm" accept=".xlsx" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Tiến hành Import
                                </button>
                            </div>
                        </div>
                        <div class="text-muted small mt-2" style="font-size: 0.76rem;">
                            <i class="bi bi-info-circle me-1"></i> Cấu trúc các cột bắt buộc: <strong>A(Mã SV)</strong>, <strong>B(Họ Tên)</strong>, <strong>C(Ngày Sinh)</strong>, <strong>D(Lớp)</strong>, <strong>E(SĐT)</strong>, <strong>F(CCCD)</strong>.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Bảng Dữ Liệu Sinh Viên Trong Card Trung Tính -->
    <div class="card border-0 shadow-xs">
        
        <!-- Toolbar Card Header -->
        <div class="card-header bg-white py-3 px-4">
            <div class="row g-3 align-items-center justify-content-between w-100 m-0">
                
                <!-- Tiêu đề & Tổng số sinh viên -->
                <div class="col-12 col-md-5 p-0">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="fw-bold text-dark mb-0 fs-6">Danh Sách Sinh Viên</h4>
                        <span class="badge bg-secondary rounded-pill">@totalSv sinh viên</span>
                    </div>
                </div>

                <!-- Form Tìm kiếm -->
                <div class="col-12 col-md-7 p-0">
                    <form asp-action="Index" method="get" class="d-flex align-items-center justify-content-md-end gap-2">
                        <div class="input-group shadow-xs" style="max-width: 360px;">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" 
                                   name="searchString" 
                                   value="@ViewData["CurrentFilter"]" 
                                   class="form-control bg-light border-start-0 ps-1" 
                                   placeholder="Tìm theo Mã SV, Họ tên, Lớp..." />
                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                Tìm kiếm
                            </button>
                        </div>

                        @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"].ToString()))
                        {
                            <a asp-action="Index" class="btn btn-outline-danger btn-sm" title="Xóa bộ lọc tìm kiếm">
                                <i class="bi bi-x-circle me-1"></i> Xóa lọc
                            </a>
                        }
                    </form>
                </div>

            </div>
        </div>

        <!-- Table Data -->
        <div class="card-body p-0">
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4 py-3">Mã SV</th>
                            <th class="py-3">Họ và Tên</th>
                            <th class="py-3">Lớp</th>
                            <th class="py-3">Phòng ở</th>
                            <th class="py-3">Số Điện Thoại</th>
                            <th class="py-3">Tình Trạng</th>
                            <th class="text-center pe-4 py-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var initial = (!string.IsNullOrWhiteSpace(item.HoTen) && item.HoTen.Trim().Contains(' '))
                                    ? item.HoTen.Trim().Substring(item.HoTen.Trim().LastIndexOf(' ') + 1)[0].ToString().ToUpper()
                                    : (!string.IsNullOrWhiteSpace(item.HoTen) ? item.HoTen.Trim().Substring(0, 1).ToUpper() : "S");
                                <tr>
                                    <!-- Mã SV -->
                                    <td class="ps-4 py-3 font-monospace fw-bold text-primary">
                                        @item.MaSV
                                    </td>

                                    <!-- Họ Tên kèm Avatar chữ -->
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white small" style="width: 32px; height: 32px; background: linear-gradient(135deg, #4f46e5, #06b6d4); flex-shrink: 0; font-size: 0.78rem;">
                                                @initial
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block">@item.HoTen</strong>
                                                @if (!string.IsNullOrEmpty(item.CCCD))
                                                {
                                                    <span class="text-muted" style="font-size: 0.72rem;">CCCD: @item.CCCD</span>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Lớp -->
                                    <td class="py-3">
                                        <span class="text-dark fw-medium">@item.Lop</span>
                                    </td>

                                    <!-- Phòng -->
                                    <td class="py-3">
                                        @if (item.Phong != null)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-door-open-fill me-1"></i>P.@item.Phong.MaPhong
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa xếp</span>
                                        }
                                    </td>

                                    <!-- Số điện thoại -->
                                    <td class="py-3 font-monospace text-muted small">
                                        @(string.IsNullOrEmpty(item.SoDienThoai) ? "-" : item.SoDienThoai)
                                    </td>

                                    <!-- Tình trạng lưu trú -->
                                    <td class="py-3">
                                        @if (item.TinhTrangLuuTru == "Đang ở")
                                        {
                                            <span class="badge bg-success">
                                                <span class="status-dot-pulse"></span>
                                                <span>Đang ở</span>
                                            </span>
                                        }
                                        else if (item.TinhTrangLuuTru == "Đình chỉ")
                                        {
                                            <span class="badge bg-danger">
                                                <span class="status-dot-pulse"></span>
                                                <span>Đình chỉ</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <span>@(string.IsNullOrEmpty(item.TinhTrangLuuTru) ? "Đã rời đi" : item.TinhTrangLuuTru)</span>
                                            </span>
                                        }
                                    </td>

                                    <!-- Nút Thao tác -->
                                    <td class="text-center pe-4 py-3">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.MaSV" class="btn btn-outline-info btn-action-icon" title="Xem chi tiết hồ sơ">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (!isKeToan)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.MaSV" class="btn btn-outline-warning btn-action-icon" title="Chỉnh sửa thông tin">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaSV" class="btn btn-outline-danger btn-action-icon" title="Xóa sinh viên">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <div class="py-3">
                                        <i class="bi bi-inbox text-muted fs-1 d-block mb-2"></i>
                                        <p class="mb-2 fw-semibold">Không tìm thấy sinh viên nào phù hợp với bộ lọc.</p>
                                        <a asp-action="Index" class="btn btn-light btn-sm">Xem lại toàn bộ danh sách</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>
