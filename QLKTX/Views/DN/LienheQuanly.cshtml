@{
    ViewData["Title"] = "Liên hệ Ban Quản Lý";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="auth-card-glass" style="max-width: 680px;">
    <!-- Header -->
    <div class="auth-header-gradient">
        <div class="auth-logo-badge">
            <i class="bi bi-headset"></i>
        </div>
        <h3 class="fw-bold mb-1 fs-5 text-white">Liên Hệ Ban Quản Lý Ký Túc Xá</h3>
        <p class="mb-0 text-white-50 small">Bộ phận tiếp nhận hỗ trợ lưu trú, tài khoản và kỹ thuật</p>
    </div>

    <!-- Body -->
    <div class="auth-body">
        <div class="row g-4">
            
            <!-- Left column: Hotline & Contact Details -->
            <div class="col-12 col-md-5 border-end-md">
                <h6 class="fw-bold text-dark mb-3">Thông tin liên hệ</h6>
                
                <div class="d-flex align-items-start gap-2 mb-3">
                    <div class="p-2 rounded-3 bg-light text-primary" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-telephone-fill small"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Hotline KTX</div>
                        <div class="fw-bold text-dark small">024.1234.5678</div>
                        <div class="text-muted small">090.1234.567</div>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-2 mb-3">
                    <div class="p-2 rounded-3 bg-light text-primary" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-envelope-fill small"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Email hỗ trợ</div>
                        <div class="fw-bold text-dark small text-break">qlktx@university.edu.vn</div>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-2 mb-3">
                    <div class="p-2 rounded-3 bg-light text-primary" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-geo-alt-fill small"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Văn phòng KTX</div>
                        <div class="text-dark small">Phòng 101, Tòa Quản Trị A, Ký túc xá Đại học</div>
                    </div>
                </div>

                <div class="p-2 rounded-3 bg-light small mt-3">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-clock-fill text-muted me-1"></i> Giờ làm việc:</div>
                    <div class="text-muted" style="font-size: 0.76rem;">Thứ 2 - Thứ 6: 07:30 - 17:00<br />Thứ 7: 08:00 - 11:30</div>
                </div>
            </div>

            <!-- Right column: Contact / Support Ticket Form -->
            <div class="col-12 col-md-7">
                @if (TempData["Success"] == null)
                {
                    <form asp-controller="DN" asp-action="ContactAdmin" method="post">
                        <div class="mb-2">
                            <label class="form-label small">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="FullName" placeholder="Nguyễn Văn A" required />
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small">Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control form-control-sm" name="Email" placeholder="sv@edu.vn" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Điện thoại</label>
                                <input type="tel" class="form-control form-control-sm" name="Phone" placeholder="09xxxxxxxx" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">Loại yêu cầu <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" name="Subject" required>
                                <option value="">-- Chọn yêu cầu --</option>
                                <option value="account">Cấp / Đổi tài khoản KTX</option>
                                <option value="room">Thủ tục xếp phòng / Chuyển phòng</option>
                                <option value="support">Hỗ trợ kỹ thuật phần mềm</option>
                                <option value="other">Yêu cầu khác</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Nội dung <span class="text-danger">*</span></label>
                            <textarea class="form-control form-control-sm" name="Message" rows="3" placeholder="Mô tả cụ thể yêu cầu của bạn..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100 py-2">
                            <i class="bi bi-send-fill"></i> Gửi yêu cầu hỗ trợ
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="text-success mb-2" style="font-size: 2.2rem;">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Gửi yêu cầu thành công!</h5>
                        <p class="text-muted small mb-3">
                            Cảm ơn bạn đã liên hệ. Ban quản lý KTX sẽ phản hồi trong vòng 24 giờ làm việc qua email hoặc SĐT.
                        </p>
                        <a asp-controller="DN" asp-action="LienheQuanly" class="btn btn-outline-primary btn-sm">Gửi yêu cầu khác</a>
                    </div>
                }
            </div>

        </div>

        <!-- Back to Login -->
        <div class="text-center pt-3 border-top mt-3">
            <a asp-controller="DN" asp-action="Dangnhap" class="text-secondary small fw-semibold text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
            </a>
        </div>
    </div>
</div>
