@model QLKTX.Models.ViPham
@{
    ViewData["Title"] = "Ghi nhận vi phạm";
}

<div class="container-fluid mt-4">
    <div class="card shadow border-danger" style="max-width: 700px; margin: auto;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Lập Biên Bản Vi Phạm</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="MaSV" class="form-label fw-bold">Sinh Viên Vi Phạm</label>
                        <select asp-for="MaSV" class="form-select" asp-items="ViewBag.MaSV" required>
                            <option value="">-- Tìm và chọn Sinh viên --</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="NoiDungViPham" class="form-label fw-bold">Lỗi Vi Phạm</label>
                        <input asp-for="NoiDungViPham" class="form-control" placeholder="VD: Sử dụng bếp điện, Về muộn..." required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="HinhThucXuLy" class="form-label fw-bold">Hình Thức Xử Lý</label>
                        <select asp-for="HinhThucXuLy" class="form-select" required>
                            <option value="Nhắc nhở">Nhắc nhở</option>
                            <option value="Cảnh cáo">Cảnh cáo toàn KTX</option>
                            <option value="Phạt tiền">Phạt tiền</option>
                            <option value="Đình chỉ">Đình chỉ lưu trú</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="NgayViPham" class="form-label fw-bold">Ngày Vi Phạm</label>
                        <input asp-for="NgayViPham" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChu" class="form-label fw-bold">Ghi chú thêm</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Chi tiết sự việc..."></textarea>
                </div>

                <div class="mt-4 border-top pt-3">
                    <button type="submit" class="btn btn-danger">Lưu Biên Bản</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>